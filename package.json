{
  "name": "@autotrace/sdk",
  "version": "1.0.0",
  "description": "Deterministic Orthogonal Diagram Routing, Layout and Multi-Objective Optimization Core & SDK",
  "type": "module",
  "main": "./dist/lib/index.cjs",
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/sdk/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/sdk/index.d.ts",
      "import": "./dist/lib/index.js",
      "require": "./dist/lib/index.cjs"
    }
  },
  "files": [
    "dist/lib",
    "dist/autotrace"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc --project tsconfig.lib.json",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx src/tests/runAllTests.ts",
    "test:sdk": "tsx src/tests/sdkTest.ts",
    "parity": "tsx scripts/runDifferentialParity.ts",
    "export-fixtures": "tsx scripts/exportParityFixtures.ts",
    "stress": "tsx scripts/stressTestMaster.ts",
    "visual:test": "tsx scripts/visualTester.ts",
    "converge:loop": "tsx scripts/cyclicConvergenceLoop.ts",
    "fuzz:1000": "tsx scripts/fuzz1000Runs.ts",
    "fuzz:10000": "tsx scripts/fuzz1000Runs.ts 10000"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/jszip": "^3.4.1",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
}
