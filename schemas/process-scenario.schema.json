{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autotrace.dev/schemas/process-scenario/1.0",
  "title": "AutoTrace Universal Process Scenario",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "jobs", "blocks", "resources"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "domain": { "type": "string" },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/job" }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/block" }
    },
    "resources": {
      "type": "array",
      "items": { "$ref": "#/$defs/resource" }
    },
    "requirementsByBlock": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/$defs/resourceRequirement" }
      }
    },
    "arrivals": { "type": "object" },
    "uncertaintyByBlock": { "type": "object" },
    "retryByBlock": { "type": "object" },
    "batchPolicies": {
      "type": "array",
      "items": { "$ref": "#/$defs/batchPolicy" }
    },
    "calendars": { "type": "object" },
    "failures": { "type": "array", "items": { "type": "object" } },
    "compatibility": {
      "type": "array",
      "items": { "$ref": "#/$defs/compatibilityPolicy" }
    },
    "changeovers": {
      "type": "array",
      "items": { "$ref": "#/$defs/changeoverPolicy" }
    },
    "objectives": {
      "type": "array",
      "items": { "$ref": "#/$defs/objective" }
    },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": true,
  "$defs": {
    "attributeValue": {
      "type": ["string", "number", "boolean", "null"]
    },
    "job": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "priority": { "type": "number" },
        "priorityClass": { "type": "string" },
        "attributes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/attributeValue" }
        },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "metadata": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "time": {
      "type": "object",
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": ["number", "null"] },
        "unit": { "enum": ["ms", "s", "min", "h"] },
        "formula": { "type": "string" }
      },
      "additionalProperties": false
    },
    "block": {
      "type": "object",
      "required": ["id", "key", "title", "automation", "time", "dependencies"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "automation": { "type": "string" },
        "time": { "$ref": "#/$defs/time" },
        "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": true
    },
    "resource": {
      "type": "object",
      "required": ["id", "name", "capacity"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "capacity": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "resourceRequirement": {
      "type": "object",
      "required": ["resourceId", "units"],
      "properties": {
        "resourceId": { "type": "string" },
        "units": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "batchPolicy": {
      "type": "object",
      "required": ["blockId", "batchCapacity", "minBatchSize", "maxWaitSeconds"],
      "properties": {
        "blockId": { "type": "string" },
        "batchCapacity": { "type": "integer", "minimum": 1 },
        "minBatchSize": { "type": "integer", "minimum": 1 },
        "maxWaitSeconds": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "compatibilityRule": {
      "type": "object",
      "required": ["attribute", "mode"],
      "properties": {
        "blockId": { "type": "string" },
        "attribute": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["same", "different", "allowed-set", "forbidden-pairs"] },
        "allowedValues": { "type": "array", "items": { "$ref": "#/$defs/attributeValue" } },
        "forbiddenPairs": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              { "$ref": "#/$defs/attributeValue" },
              { "$ref": "#/$defs/attributeValue" }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "missingValue": { "enum": ["allow", "reject", "separate"] }
      },
      "additionalProperties": false
    },
    "compatibilityPolicy": {
      "type": "object",
      "required": ["id", "rules"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "blockIds": { "type": "array", "items": { "type": "string" } },
        "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/compatibilityRule" } }
      },
      "additionalProperties": true
    },
    "changeoverPolicy": {
      "type": "object",
      "required": ["id", "stateAttributes", "defaultSeconds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "resourceId": { "type": "string" },
        "blockId": { "type": "string" },
        "stateAttributes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "defaultSeconds": { "type": "number", "minimum": 0 },
        "sameStateSeconds": { "type": "number", "minimum": 0 },
        "matrixSeconds": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "type": "number", "minimum": 0 }
          }
        },
        "initialState": { "type": "string" },
        "metadata": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "objective": {
      "type": "object",
      "required": ["id", "metric", "goal", "weight"],
      "properties": {
        "id": { "type": "string" },
        "metric": { "type": "string" },
        "goal": { "enum": ["maximize", "minimize", "target"] },
        "weight": { "type": "number", "minimum": 0 },
        "target": { "type": "number" },
        "tolerance": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
